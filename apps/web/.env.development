# Local development defaults (committed; NO real secrets here).
# Runs against the Firebase emulators with the mock OAuth provider.
# Override locally in .env.development.local (git-ignored), e.g. to use real OAuth clients.
APP_URL=http://localhost:3000
OAUTH_MOCK=1
GCLOUD_PROJECT=demo-calendar-sync
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_API_KEY=fake-api-key
# Dev-only token encryption key. Production uses Cloud KMS (KMS_KEY_NAME).
TOKEN_ENC_KEY=dpEQHJOFHCuKGUDbRzvR0GfNauHT9q5PsUijKNMo0Do=
