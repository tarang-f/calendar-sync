# Copy to .env.development.local to use real OAuth clients locally (set OAUTH_MOCK=0).
APP_URL=http://localhost:3000
OAUTH_MOCK=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Production only (App Hosting):
# APP_ENV=production
# FIREBASE_API_KEY=<Firebase web API key>
# KMS_KEY_NAME=projects/<project>/locations/<region>/keyRings/calendar-sync/cryptoKeys/oauth-tokens
